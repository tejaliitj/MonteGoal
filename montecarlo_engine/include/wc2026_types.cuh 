#pragma once

#include <cuda_runtime.h>
#include <curand_kernel.h>

constexpr int WC_NUM_TEAMS = 48;
constexpr int WC_NUM_GROUPS = 12;
constexpr int WC_GROUP_SIZE = 4;

constexpr int WC_NUM_FIXTURES = 72;
constexpr int WC_NUM_R32_MATCHES = 16;

constexpr int WC_NUM_STAGES = 7;

enum WCStage {
    STAGE_GROUP = 0,
    STAGE_R32 = 1,
    STAGE_R16 = 2,
    STAGE_QF = 3,
    STAGE_SF = 4,
    STAGE_FINAL = 5,
    STAGE_CHAMPION = 6
};

/*
 * Data associated with one team.
 *
 * index:
 *     Internal GPU index: 0 ... 47
 *
 * id:
 *     Actual FIFA/team ID if available.
 *
 * group_id:
 *     Internal group index: 0 ... 11
 */
struct TeamGPU {

    int id;
    int group_id;
};

/*
 * Fixture using INTERNAL team indices.
 *
 * Example:
 * home_idx = 4
 * away_idx = 17
 */
struct FixtureGPU {

    int home_idx;
    int away_idx;
};

/*
 * Tournament standings for one team.
 */
struct StatsGPU {

    int P;
    int W;
    int D;
    int L;

    int GF;
    int GA;
    int GD;

    int Pts;
};